MERCHANT_1=https://headphone-zone.myshopify.com/api/ucp/mcp
MERCHANT_2=https://bombay-shaving.myshopify.com/api/ucp/mcp
MERCHANT_3=https://mokobara.myshopify.com/api/ucp/mcp

# Prava sandbox credentials (https://docs.prava.space/authentication)
PRAVA_BASE_URL=https://sandbox.api.prava.space
PRAVA_SECRET_KEY=sk_test_xxx
PRAVA_API_KEY=pk_test_xxx

# SwarmPay reputation API (run locally: cd swarmpay-backend && go run ./cmd/reputation-api)
SWARMPAY_API_URL=http://localhost:8080
SWARMPAY_API_KEY=

# Wallet to check against the SwarmPay trust gate before every purchase.
# Overrides internal/reputation's default (a real C-tier/blocked test wallet).
# Try each to see all three decision paths:
#   blocked:       0x9cab350e3485e3981b0e729d3cfdb90992a56e9c (real, score 220 -> 22)
#   human_review:  0xca4b519063ff7f8154fcb768259bc9059df07237 (real, score 600 -> 60)
#   auto_approve:  0xaaaa000000000000000000000000000000aaaa  (seeded test fixture, score 900 -> 90)
WALLET_ADDRESS=

# cmd/pay: which hardcoded product+merchant to buy. Both run through the same
# trust-gate -> Prava -> UCP checkout flow (internal/purchase).
#   headphones (default): Sennheiser HD 600 @ Headphone Zone, Rs.22,990
#                          — exceeds every trust tier's spend limit, so it
#                          only ever reaches auto_approve if a wallet's real
#                          limit happens to cover it; otherwise human_review
#                          or blocked depending on score.
#   shaving:               Sensi Smart 3 Razor @ Bombay Shaving Company, Rs.99
#                          (confirmed live via search_catalog/get_product)
#                          — comfortably clears the 70+ tier's Rs.10,000
#                          limit, so a good wallet auto-approves it.
PRODUCT_CHOICE=headphones

# cmd/agent decision loop (only runs if TASK is set — otherwise cmd/agent
# falls back to its original tools/list + search_catalog demo across all
# configured merchants). Searches MERCHANT_1 (headphones) and MERCHANT_2
# (razor) live, picks the best in-budget/task-relevant match, then hands off
# to the same internal/purchase flow PRODUCT_CHOICE uses above.
#   TASK="buy a cheap razor" BUDGET_RUPEES=500     -> lands on shaving
#   TASK="buy good headphones" BUDGET_RUPEES=30000 -> lands on headphones
TASK=
BUDGET_RUPEES=1000