# Base URL cmd/server is reachable at. Defaults to /api (same-origin), which
# works when the frontend is served behind a reverse proxy that forwards
# /api/* to cmd/server, or during local dev via vite.config.ts's proxy.
# Set explicitly for a deploy where the API lives on a different origin.
VITE_API_BASE=https://your-api-host.example.com/api
